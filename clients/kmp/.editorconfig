root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_function_signature_body_expression_wrapping = default
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_trailing-comma-on-declaration-site = enabled
ktlint_standard_trailing-comma-on-call-site = enabled
# @Composable functions follow Compose's PascalCase convention; ktlint's own
# documented knob for that, matching detekt's naming>FunctionNaming.ignoreAnnotated.
ktlint_function_naming_ignore_when_annotated_with = Composable
