-- A book of money (PRODUCT.md §3). Instants are epoch milliseconds; a
-- non-null deleted_at is a tombstone (§6, sync-ready data).
CREATE TABLE ledgers (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

insertLedger:
INSERT INTO ledgers (id, name, created_at, updated_at, deleted_at)
VALUES (?, ?, ?, ?, NULL);

liveLedgers:
SELECT * FROM ledgers WHERE deleted_at IS NULL ORDER BY rowid;

liveLedger:
SELECT * FROM ledgers WHERE id = ? AND deleted_at IS NULL;

allLedgers:
SELECT * FROM ledgers ORDER BY rowid;

renameLedger:
UPDATE ledgers SET name = ?, updated_at = ? WHERE id = ? AND deleted_at IS NULL;
