-- One movement of money on one date. A deleted transaction stays as a
-- tombstone, its line items with it. The recurring columns come last: they
-- were added by migration 1, which appends them (SELECT * reads by position).
CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    ledger_id TEXT NOT NULL REFERENCES ledgers(id),
    date TEXT NOT NULL,
    direction TEXT NOT NULL,
    amount INTEGER NOT NULL,
    category_id TEXT REFERENCES categories(id),
    memo TEXT,
    store_name TEXT,
    photo_id TEXT REFERENCES photos(id),
    needs_review INTEGER NOT NULL DEFAULT 0,
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    recurring_rule_id TEXT,
    recurring_month TEXT
);

CREATE INDEX transactions_ledger_date ON transactions(ledger_id, date);

CREATE TABLE line_items (
    id TEXT NOT NULL PRIMARY KEY,
    transaction_id TEXT NOT NULL REFERENCES transactions(id),
    position INTEGER NOT NULL,
    amount INTEGER NOT NULL,
    category_id TEXT NOT NULL REFERENCES categories(id),
    name TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX line_item_transaction ON line_items(transaction_id);

-- A recurring rule's month is recorded once; a deleted one keeps its month done.
CREATE UNIQUE INDEX transactions_recurring_month ON transactions(recurring_rule_id, recurring_month)
WHERE recurring_rule_id IS NOT NULL;

insertTransaction:
INSERT INTO transactions (
    id, ledger_id, date, direction, amount, category_id, memo, store_name, photo_id,
    needs_review, device_id, created_at, updated_at, deleted_at, recurring_rule_id, recurring_month
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, ?);

insertLineItem:
INSERT INTO line_items (id, transaction_id, position, amount, category_id, name, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

liveTransaction:
SELECT * FROM transactions WHERE ledger_id = ? AND id = ? AND deleted_at IS NULL;

liveTransactionsBetween:
SELECT * FROM transactions
WHERE ledger_id = :ledgerId AND deleted_at IS NULL AND date >= :fromDate AND date <= :toDate
ORDER BY date DESC, created_at DESC, rowid DESC;

totalsBetween:
SELECT direction, SUM(amount) AS total FROM transactions
WHERE ledger_id = :ledgerId AND deleted_at IS NULL AND date >= :fromDate AND date <= :toDate
GROUP BY direction;

-- A range's expenses by category: an unsplit expense in its own category,
-- a split one's items each in theirs. Income is never counted.
expenseByCategoryBetween:
SELECT category_id, SUM(amount) AS total FROM (
    SELECT t.category_id AS category_id, t.amount AS amount FROM transactions AS t
    WHERE t.ledger_id = :ledgerId AND t.deleted_at IS NULL AND t.direction = 'EXPENSE'
        AND t.category_id IS NOT NULL AND t.date >= :fromDate AND t.date <= :toDate
    UNION ALL
    SELECT i.category_id AS category_id, i.amount AS amount FROM line_items AS i
    JOIN transactions AS t ON t.id = i.transaction_id
    WHERE t.ledger_id = :ledgerId AND t.deleted_at IS NULL AND t.direction = 'EXPENSE'
        AND t.date >= :fromDate AND t.date <= :toDate
)
GROUP BY category_id;

-- A range's expenses by date, for the dates that have any.
expenseByDateBetween:
SELECT date, SUM(amount) AS total FROM transactions
WHERE ledger_id = :ledgerId AND deleted_at IS NULL AND direction = 'EXPENSE'
    AND date >= :fromDate AND date <= :toDate
GROUP BY date;

-- A range's expenses by month (yyyy-MM), for the months that have any.
expenseByMonthBetween:
SELECT substr(date, 1, 7) AS month, SUM(amount) AS total FROM transactions
WHERE ledger_id = :ledgerId AND deleted_at IS NULL AND direction = 'EXPENSE'
    AND date >= :fromDate AND date <= :toDate
GROUP BY month;

lineItemsOf:
SELECT * FROM line_items WHERE transaction_id = ? ORDER BY position;

updateMemo:
UPDATE transactions SET memo = ?, updated_at = ? WHERE ledger_id = ? AND id = ? AND deleted_at IS NULL;

updateTransaction:
UPDATE transactions
SET date = :date, direction = :direction, amount = :amount, category_id = :categoryId, memo = :memo,
    store_name = :storeName, photo_id = :photoId, updated_at = :updatedAt
WHERE ledger_id = :ledgerId AND id = :id AND deleted_at IS NULL;

deleteLineItemsOf:
DELETE FROM line_items WHERE transaction_id = ?;

searchTransactions:
SELECT * FROM transactions AS t
WHERE t.ledger_id = :ledgerId AND t.deleted_at IS NULL
    AND (:fromDate IS NULL OR t.date >= :fromDate)
    AND (:toDate IS NULL OR t.date <= :toDate)
    AND (:minAmount IS NULL OR t.amount >= :minAmount)
    AND (:maxAmount IS NULL OR t.amount <= :maxAmount)
    AND (
        :categoryId IS NULL OR t.category_id = :categoryId
        OR EXISTS (SELECT 1 FROM line_items AS i WHERE i.transaction_id = t.id AND i.category_id = :categoryId)
    )
    AND (
        :text IS NULL OR instr(t.memo, :text) > 0 OR instr(t.store_name, :text) > 0
        OR EXISTS (SELECT 1 FROM line_items AS i WHERE i.transaction_id = t.id AND instr(i.name, :text) > 0)
    )
ORDER BY t.date DESC, t.created_at DESC, t.rowid DESC;

recordedMonthCount:
SELECT COUNT(*) FROM transactions
WHERE ledger_id = :ledgerId AND recurring_rule_id = :ruleId AND recurring_month = :month;

-- The last month a rule recorded, deleted transactions included.
lastRecordedMonth:
SELECT MAX(recurring_month) AS month FROM transactions
WHERE ledger_id = :ledgerId AND recurring_rule_id = :ruleId;

markTransactionDeleted:
UPDATE transactions SET deleted_at = ? WHERE ledger_id = ? AND id = ? AND deleted_at IS NULL;

allTransactions:
SELECT * FROM transactions ORDER BY rowid;
