# Deny by default: ignore everything, then allow explicitly
*

!.gitignore
!README.md
!CLAUDE.md
!PRODUCT.md
!DECISIONS.md
!TODO.md

# Harness
!Makefile
!mise.toml
!hooks/
!hooks/**
!scripts/
!scripts/**
!quality/
!quality/**
!.claude/
!.claude/settings.json
!.claude/agents/
!.claude/agents/**

# Executable acceptance criteria (PRODUCT.md §7)
!acceptance/
!acceptance/**

# KMP client (ignores delegated to clients/kmp/.gitignore)
!clients/
!clients/kmp/
!clients/kmp/**

# Human-facing docs
!docs/
!docs/handbook/
!docs/handbook/**

# Never commit (agent-only design docs). Must stay last: it re-ignores
# docs/superpowers/ after the docs/ allow above.
docs/superpowers/
