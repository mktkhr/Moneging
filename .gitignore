# Deny by default: ignore everything, then allow explicitly
*

!.gitignore
!README.md
!CLAUDE.md

# Harness
!Makefile
!hooks/
!hooks/**
!scripts/
!scripts/**
!quality/
!quality/**
!.claude/
!.claude/settings.json

# KMP client (ignores delegated to clients/kmp/.gitignore)
!clients/
!clients/kmp/
!clients/kmp/**

# Never commit (agent-only design docs)
docs/superpowers/
